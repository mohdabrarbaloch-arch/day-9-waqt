# ---- Waqt environment variables ----
# Copy this file to .env and fill in real values.

# Secret used to sign JWT access tokens. MUST be at least 32 chars.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Access token lifetime in minutes (default: 24 hours = 1440)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL.
# Development (default): SQLite on disk, WAL mode.
DATABASE_URL=sqlite:///./waqt.db
# Production (PostgreSQL 16 via docker-compose):
# DATABASE_URL=postgresql+psycopg://waqt:waqt@db:5432/waqt

# Comma-separated list of allowed CORS origins (no spaces).
# Example: https://waqt.vercel.app,http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# Environment: development | production
ENVIRONMENT=development

# Optional: Vercel serverless deployments use this to keep SQLite in /tmp
# (set automatically by Vercel; leave blank otherwise)
VERCEL=0
